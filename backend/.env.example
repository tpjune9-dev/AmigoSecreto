# Configuración de Base de Datos MySQL
DATABASE_URL="mysql://usuario:password@localhost:3306/amigo_secreto"

# Puerto del servidor backend
PORT=4000
NODE_ENV=development

# Clave secreta para firmar tokens JWT (usar una cadena aleatoria larga y segura en producción)
JWT_SECRET="cambia_este_secreto_por_uno_muy_largo_y_seguro_en_produccion_2026"

# URL del frontend permitida por CORS (ej. https://tu-usuario.github.io o http://localhost:5173)
FRONTEND_URL="http://localhost:5173"

# Integración Opcional con WhatsApp Business Cloud API (Meta)
# Dejar vacíos si solo se utiliza la modalidad inicial con enlaces wa.me
WHATSAPP_API_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v20.0"

