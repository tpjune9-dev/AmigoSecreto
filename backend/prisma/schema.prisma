generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoSorteo {
  INSCRIPCIONES_ABIERTAS
  INSCRIPCIONES_CERRADAS
  SORTEO_REALIZADO
}

model Administrador {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(120)
  email         String   @unique @db.VarChar(160)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now())

  sorteos       Sorteo[]

  @@map("administradores")
}

model Sorteo {
  id               Int          @id @default(autoincrement())
  administrador_id Int
  nombre           String       @db.VarChar(150)
  codigo_unico     String       @unique @db.VarChar(20)
  descripcion      String?      @db.Text
  fecha_evento     DateTime
  presupuesto      Decimal?     @db.Decimal(10, 2)
  estado           EstadoSorteo @default(INSCRIPCIONES_ABIERTAS)
  created_at       DateTime     @default(now())

  administrador    Administrador  @relation(fields: [administrador_id], references: [id], onDelete: Cascade)
  participantes    Participante[]
  asignaciones     Asignacion[]

  @@index([administrador_id])
  @@index([codigo_unico])
  @@map("sorteos")
}

model Participante {
  id             Int      @id @default(autoincrement())
  sorteo_id      Int
  nombre         String   @db.VarChar(120)
  telefono       String   @db.VarChar(30)
  pin_hash       String   @db.VarChar(255)
  consentimiento Boolean  @default(true)
  created_at     DateTime @default(now())

  sorteo              Sorteo       @relation(fields: [sorteo_id], references: [id], onDelete: Cascade)
  asignacionesOrigen  Asignacion[] @relation("ParticipanteOrigen")
  asignacionesDestino Asignacion[] @relation("ParticipanteDestino")

  @@unique([sorteo_id, telefono], name: "uq_sorteo_telefono")
  @@index([sorteo_id])
  @@map("participantes")
}

model Asignacion {
  id                      Int      @id @default(autoincrement())
  sorteo_id               Int
  participante_origen_id  Int
  participante_destino_id Int
  created_at              DateTime @default(now())

  sorteo              Sorteo       @relation(fields: [sorteo_id], references: [id], onDelete: Cascade)
  participanteOrigen  Participante @relation("ParticipanteOrigen", fields: [participante_origen_id], references: [id], onDelete: Cascade)
  participanteDestino Participante @relation("ParticipanteDestino", fields: [participante_destino_id], references: [id], onDelete: Cascade)

  @@unique([sorteo_id, participante_origen_id], name: "uq_sorteo_origen")
  @@unique([sorteo_id, participante_destino_id], name: "uq_sorteo_destino")
  @@index([sorteo_id])
  @@map("asignaciones")
}

